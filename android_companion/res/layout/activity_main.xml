<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="#0F172A">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🛡️ MobileShield"
        android:textColor="#38BDF8"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginTop="32dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Phase 2: Live Network Intrusion Detection"
        android:textColor="#94A3B8"
        android:textSize="14sp"
        android:layout_marginTop="6dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#334155"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Status: Idle (Capture Stopped)"
        android:textColor="#F1F5F9"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/tvPacketStats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Packets Sent to Laptop: 0"
        android:textColor="#38BDF8"
        android:textSize="15sp"
        android:layout_marginTop="10dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/vpn_prompt"
        android:textColor="#94A3B8"
        android:textSize="13sp"
        android:layout_marginTop="24dp"
        android:lineSpacingExtra="3dp" />

    <EditText
        android:id="@+id/etPairingCode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Operator-issued one-use pairing code"
        android:inputType="textPassword"
        android:singleLine="true"
        android:textColor="#F1F5F9"
        android:textColorHint="#64748B"
        android:layout_marginTop="18dp" />

    <Button
        android:id="@+id/btnEnrollDevice"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="ENROLL DEVICE"
        android:textSize="14sp"
        android:layout_marginTop="8dp"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/btnToggleVpn"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="START CAPTURE"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginTop="36dp"
        android:background="#0284C7"
        android:textColor="#FFFFFF" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Connected to Laptop over USB (127.0.0.1:8000)"
        android:textColor="#64748B"
        android:textSize="12sp"
        android:layout_marginTop="24dp" />

</LinearLayout>
